# Pinned tool and image versions for every lab.
# Why pin? A lab that silently picks up "latest" can break the day upstream
# ships a new release. Pinning makes the labs reproducible - the same idea as
# only upgrading AOS/AHV on purpose, after reading the release notes.
#
# Verified: 2026-09-29. When bumping, update CLAUDE.md "Pinned versions" too.

# kind = "Kubernetes IN Docker": each Kubernetes node is a Docker container.
# https://github.com/kubernetes-sigs/kind/releases/tag/v0.33.0
KIND_VERSION=v0.33.0
KIND_SHA256_LINUX_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d

# Node image pinned by digest (kind release notes recommend digests).
# Kubernetes v1.36 matches Harvester v1.9.0, which ships RKE2 v1.36.3+rke2r1
# (https://github.com/harvester/harvester/blob/v1.9.0/scripts/version-rke2).
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# kubectl should be within one minor version of the cluster (version skew policy):
# https://kubernetes.io/releases/version-skew-policy/#kubectl
KUBECTL_VERSION=v1.36.5
KUBECTL_SHA256_LINUX_AMD64=33bc88a24c3b09cf55bfd59e6ca977881b61fc3f25ab65bc80c65b430248648e

# Container images used by the labs (small, official images).
IMG_NGINX_OLD=nginx:1.29-alpine
IMG_NGINX_NEW=nginx:1.30-alpine
IMG_BUSYBOX=busybox:1.37
IMG_CURL=curlimages/curl:8.16.0
IMG_REGISTRY=registry:3

# Target platform for Tiers 3-4, and the components it bundles (reference only).
# Read from the v1.9.0 tag of https://github.com/harvester/harvester
#   scripts/version-rke2, scripts/version-rancher, deploy/charts/harvester/{Chart,values}.yaml
HARVESTER_TARGET_VERSION=v1.9.0
HARVESTER_RKE2_VERSION=v1.36.3+rke2r1
HARVESTER_KUBEVIRT_VERSION=1.8.4      # SUSE build tag 1.8.4-9.1
HARVESTER_CDI_VERSION=1.65.0
HARVESTER_LONGHORN_VERSION=1.12.1
HARVESTER_RANCHER_VERSION=v2.15.0
