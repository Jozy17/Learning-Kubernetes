# Copy to .env (git-ignored) and fill in ONLY for labs that need it.
# Never commit real values. Tier 1 needs nothing from this file.

# --- Tier 4 (later): vm-import-controller practice ---
# vcsim (the vCenter simulator) uses throwaway credentials; these are examples.
VSPHERE_ENDPOINT=https://vcsim.example.invalid/sdk
VSPHERE_USERNAME=CHANGE_ME
VSPHERE_PASSWORD=CHANGE_ME
VSPHERE_DATACENTER=DC0

# URL of a small, freely available OVA to import (filled in during Tier 4)
OVA_URL=http://ova-host.example.invalid/example.ova
